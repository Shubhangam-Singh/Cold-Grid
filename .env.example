# ColdGrid environment flags.
#
# RULE 3: every flag defaults to FREE MODE. With this file copied to
# .env.local unchanged (or with no .env.local at all), the entire app
# builds, runs, demos, and submits for ₹0 — no keys, no paid services.
#
# .env.local is git-ignored. NEVER commit real keys.

# ── AI Copilot (Phase 7) ─────────────────────────────────────────────
# false → deterministic heuristic advisor (pure TS, no network calls).
# true  → live Anthropic copilot via app/api/copilot (needs API key).
NEXT_PUBLIC_ENABLE_COPILOT=false

# Only read when NEXT_PUBLIC_ENABLE_COPILOT=true. Server-side only.
# ANTHROPIC_API_KEY=

# ── Blockchain ledger (Phase 9) ──────────────────────────────────────
# false → in-app simulated ledger (TS + visual blocks, no real chain).
# true  → ethers.js against a deployed ColdChainAttestation contract.
NEXT_PUBLIC_ENABLE_CHAIN=false

# Only read when NEXT_PUBLIC_ENABLE_CHAIN=true. Set after a local
# Hardhat or Sepolia testnet deploy. Never mainnet, never real money.
# NEXT_PUBLIC_CONTRACT_ADDRESS=

# ── Hardware-in-the-loop bridge (Phase 10) ───────────────────────────
# false → synthetic sensor data generated by the simulation.
# true  → live PPSC cart readings via the Python serial→WebSocket bridge.
NEXT_PUBLIC_ENABLE_HARDWARE=false

# Only read when NEXT_PUBLIC_ENABLE_HARDWARE=true.
# Example: ws://localhost:8765
# NEXT_PUBLIC_WS_URL=
